DATABASE_URL=postgresql://user:password@host:5432/dbname

# First admin (created by npm run bootstrap / first login)
BOOTSTRAP_ADMIN_EMAIL=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Admin

JWT_SECRET=change-me
CRON_SECRET=change-me
# HEALTH_SECRET=optional

# Public blog + marketing chrome
# Canonical blog base (include /blogs when marketing rewrites onto this app)
NEXT_PUBLIC_SITE_URL=https://author-ai-assistant.vercel.app
NEXT_PUBLIC_MARKETING_SITE_URL=https://ai-author-assistant-website.vercel.app

# TinyMCE is self-hosted from /public/tinymce (no API key required)

# Hostinger media (required)
STORAGE_PROVIDER=hostinger
HOSTINGER_PUBLIC_BASE_URL=https://cdn.example.com
HOSTINGER_MEDIA_API_BASE_URL=https://cdn.example.com/media-api
HOSTINGER_MEDIA_SIGNING_SECRET=long-random-shared-with-hostinger-config
HOSTINGER_UPLOAD_TICKET_TTL_SEC=900
HOSTINGER_CHUNK_SIZE_BYTES=5242880
HOSTINGER_UPLOAD_TIMEOUT_MS=30000
# Include every origin where /admin editors upload (app host; marketing host if rewritten)
MEDIA_UPLOAD_CORS_ORIGINS=https://author-ai-assistant.vercel.app
